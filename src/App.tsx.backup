import { useState } from 'react';
import { Capacitor, CapacitorHttp } from '@capacitor/core';

const API_BASE_URL = 'http://10.0.2.2:5010/api/mobile/v1';

type ApiResult = {
  ok?: boolean;
  error?: string;
  message?: string;
  access_token?: string;
  expires_in?: number;
  user?: {
    id?: string;
    username?: string;
    full_name?: string;
    role?: string;
  };
  sites?: Array<{
    id: string;
    name: string;
    plants?: Array<{
      id: string;
      name: string;
      location?: string;
    }>;
  }>;
  capabilities?: Record<string, unknown>;
};

async function apiRequest(
  path: string,
  method: 'GET' | 'POST',
  token?: string,
  data?: Record<string, string>
): Promise<ApiResult> {
  const headers: Record<string, string> = {
    Accept: 'application/json',
  };

  if (data) headers['Content-Type'] = 'application/json';
  if (token) headers.Authorization = `Bearer ${token}`;

  let status: number;
  let result: ApiResult;

  if (Capacitor.isNativePlatform()) {
    const response = await CapacitorHttp.request({
      url: `${API_BASE_URL}${path}`,
      method,
      headers,
      data,
      connectTimeout: 15000,
      readTimeout: 20000,
    });

    status = response.status;
    result = response.data as ApiResult;
  } else {
    const response = await fetch(`${API_BASE_URL}${path}`, {
      method,
      headers,
      body: data ? JSON.stringify(data) : undefined,
    });

    status = response.status;
    result = await response.json() as ApiResult;
  }

  if (status < 200 || status >= 300) {
    throw new Error(
      result.error || result.message || `Server returned HTTP ${status}`
    );
  }

  return result;
}

const pageStyle: React.CSSProperties = {
  minHeight: '100dvh',
  boxSizing: 'border-box',
  background: '#f5f4ef',
  color: '#202b25',
  fontFamily: 'Arial, sans-serif',
  padding: '24px 18px 40px',
};

const cardStyle: React.CSSProperties = {
  background: '#ffffff',
  border: '1px solid #e4e6df',
  borderRadius: 16,
  padding: 22,
  boxShadow: '0 4px 18px rgba(25, 40, 30, 0.05)',
};

const inputStyle: React.CSSProperties = {
  width: '100%',
  boxSizing: 'border-box',
  padding: '13px 12px',
  marginTop: 7,
  border: '1px solid #d5d9d1',
  borderRadius: 9,
  fontSize: 16,
  background: '#fff',
  color: '#202b25',
};

const buttonStyle: React.CSSProperties = {
  width: '100%',
  border: 0,
  borderRadius: 9,
  padding: 14,
  background: '#176b45',
  color: '#fff',
  fontSize: 16,
  fontWeight: 700,
  cursor: 'pointer',
};

export default function App() {
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [token, setToken] = useState<string | null>(null);
  const [session, setSession] = useState<ApiResult | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [notice, setNotice] = useState('');

  async function handleLogin(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setLoading(true);
    setError('');
    setNotice('');

    try {
      const login = await apiRequest('/auth/token', 'POST', undefined, {
        username: username.trim(),
        password,
      });

      if (!login.access_token) {
        throw new Error('The server did not return an access token.');
      }

      const accessToken = login.access_token;
      const bootstrap = await apiRequest('/bootstrap', 'GET', accessToken);

      setToken(accessToken);
      setSession(bootstrap);
      setPassword('');
      setNotice('Login successful. Secure API authentication is working.');
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Unable to connect to the server.');
    } finally {
      setLoading(false);
    }
  }

  async function refreshBootstrap() {
    if (!token) return;

    setLoading(true);
    setError('');
    setNotice('');

    try {
      const result = await apiRequest('/bootstrap', 'GET', token);
      setSession(result);
      setNotice('Bootstrap data refreshed successfully.');
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Unable to refresh server data.');
    } finally {
      setLoading(false);
    }
  }

  function logout() {
    setToken(null);
    setSession(null);
    setUsername('');
    setPassword('');
    setError('');
    setNotice('You have been logged out.');
  }

  const user = session?.user;
  const sites = session?.sites ?? [];
  const nativeApp = Capacitor.isNativePlatform();

  return (
    <main style={pageStyle}>
      <header style={{
        display: 'flex',
        alignItems: 'center',
        gap: 12,
        margin: '8px auto 28px',
        maxWidth: 520,
      }}>
        <div style={{
          background: '#176b45',
          color: '#fff',
          width: 46,
          height: 46,
          borderRadius: 12,
          display: 'grid',
          placeItems: 'center',
          fontWeight: 800,
          fontSize: 25,
        }}>S</div>
        <div>
          <div style={{ fontSize: 22, fontWeight: 800 }}>Solar Audit</div>
          <div style={{ fontSize: 13, color: '#667168', marginTop: 3 }}>
            CleanMax · Audit workspace
          </div>
        </div>
      </header>

      <section style={{ ...cardStyle, maxWidth: 476, margin: '0 auto' }}>
        {!token ? (
          <>
            <p style={{
              color: '#176b45',
              fontWeight: 700,
              fontSize: 12,
              letterSpacing: 1.2,
            }}>ACCOUNT ACCESS</p>

            <h1 style={{ fontSize: 27, margin: '8px 0' }}>Welcome back</h1>
            <p style={{ color: '#667168', lineHeight: 1.5, fontSize: 14 }}>
              Sign in with your existing Solar Audit account.
            </p>

            <form onSubmit={handleLogin}>
              <label style={{ display: 'block', marginTop: 24, fontWeight: 600 }}>
                Username
                <input
                  style={inputStyle}
                  value={username}
                  onChange={event => setUsername(event.target.value)}
                  autoComplete="username"
                  required
                  disabled={loading}
                />
              </label>

              <label style={{ display: 'block', marginTop: 18, fontWeight: 600 }}>
                Password
                <input
                  style={inputStyle}
                  type="password"
                  value={password}
                  onChange={event => setPassword(event.target.value)}
                  autoComplete="current-password"
                  required
                  disabled={loading}
                />
              </label>

              <button
                style={{ ...buttonStyle, marginTop: 24, opacity: loading ? 0.7 : 1 }}
                type="submit"
                disabled={loading}
              >
                {loading ? 'Connecting…' : 'Sign in'}
              </button>
            </form>
          </>
        ) : (
          <>
            <p style={{
              color: '#176b45',
              fontWeight: 700,
              fontSize: 12,
              letterSpacing: 1.2,
            }}>AUTHENTICATED WORKSPACE</p>

            <h1 style={{ fontSize: 25, marginBottom: 6 }}>
              Welcome{user?.full_name ? `, ${user.full_name}` : ''}
            </h1>

            <p style={{ color: '#667168', fontSize: 14 }}>
              Username: {user?.username ?? '—'}
            </p>
            <p style={{ color: '#667168', fontSize: 14 }}>
              Role: {user?.role ?? '—'}
            </p>

            <div style={{
              background: '#e8f4eb',
              color: '#176b45',
              padding: 14,
              borderRadius: 10,
              marginTop: 20,
              fontWeight: 700,
            }}>
              ✓ Backend authentication successful
            </div>

            <h2 style={{ fontSize: 18, marginTop: 26 }}>Authorized sites</h2>

            {sites.length === 0 ? (
              <p style={{ color: '#667168' }}>
                Authentication succeeded, but no site information was returned.
              </p>
            ) : sites.map(site => (
              <article key={site.id} style={{
                border: '1px solid #e4e6df',
                borderRadius: 10,
                padding: 14,
                marginTop: 10,
              }}>
                <strong>{site.name}</strong>
                <p style={{ fontSize: 12, color: '#667168', marginBottom: 0 }}>
                  {site.plants?.length ?? 0} authorized plants returned
                </p>
              </article>
            ))}

            <button
              type="button"
              style={{ ...buttonStyle, marginTop: 22 }}
              onClick={refreshBootstrap}
              disabled={loading}
            >
              {loading ? 'Refreshing…' : 'Refresh server data'}
            </button>

            <button
              type="button"
              style={{
                ...buttonStyle,
                marginTop: 10,
                background: '#e9ece7',
                color: '#26352b',
              }}
              onClick={logout}
              disabled={loading}
            >
              Sign out
            </button>
          </>
        )}

        {loading && (
          <p role="status" style={{ fontSize: 13, color: '#667168' }}>
            Contacting the Solar Audit server…
          </p>
        )}

        {notice && (
          <p role="status" style={{
            color: '#176b45',
            background: '#e8f4eb',
            padding: 11,
            borderRadius: 8,
            fontSize: 13,
            lineHeight: 1.5,
          }}>{notice}</p>
        )}

        {error && (
          <div role="alert" style={{
            color: '#a12b25',
            background: '#fff0ee',
            border: '1px solid #f0cfca',
            padding: 12,
            borderRadius: 8,
            marginTop: 16,
            fontSize: 14,
            overflowWrap: 'anywhere',
          }}>
            <strong>Connection failed</strong>
            <p style={{ marginBottom: 0 }}>{error}</p>
          </div>
        )}
      </section>

      <p style={{
        textAlign: 'center',
        maxWidth: 460,
        margin: '20px auto 0',
        color: '#667168',
        fontSize: 12,
        lineHeight: 1.6,
      }}>
        {nativeApp ? 'Android application' : 'Web preview'} · API v1
        <br />
        Initial integration test · Audit workflows not yet connected
      </p>
    </main>
  );
}
