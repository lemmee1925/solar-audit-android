        </div>}
        {section === "Reports" && <div className="page-content"><div className="section-heading"><div><h2>Audit Reports</h2><p>Generate a PDF with checklist results, inspection photos, observations, and action-taken photos.</p></div><span className="date-tag">{audits.length} AUDIT(S)</span></div><div className="local-note report-note"><Icon name="report" /><span><b>Local report generation</b><br />Reports are generated on this device. Submitted audits are locked; draft reports are labelled with their current status.</span></div>{audits.length === 0 ? <div className="empty-state large-empty"><div className="empty-icon"><Icon name="report" /></div><h3>No audits available</h3><p>Create an audit and save checklist results before generating a report.</p><button className="secondary-button" onClick={() => setSection("Audits")}>View audits <Icon name="arrow" /></button></div> : <div className="report-list">{audits.map((audit) => <article className="content-card report-row" key={audit.id}><div className="audit-type-mark"><Icon name="report" /></div><div className="audit-copy"><b>{audit.title}</b><small>{audit.plantName || current.plants.find((p) => p.id === audit.plantId)?.name || "Plant"} Â· {audit.auditType} Â· {audit.auditDate}</small><small>Auditor: {audit.auditor || "Not specified"}</small></div><span className={`audit-status report-status-${audit.status}`}>{audit.status.replace("_", " ")}</span><button className="primary-button report-generate-button" onClick={() => void generateAuditReport(audit)}>Generate PDF</button></article>)}</div>}</div>}
        {section === "Settings" && <div className="page-content"><section className="content-card settings-card"><div className="card-heading"><div><h3>Workspace settings</h3><p>Review the information saved on this device.</p></div><div className="metric-icon"><Icon name="settings" /></div></div><div className="settings-field"><span>Organization</span><b>{current.organizationName}</b></div><div className="settings-field"><span>Site name</span><b>{current.siteName}</b></div><div className="settings-field"><span>Site location</span><b>{current.siteLocation || "Not provided"}</b></div><div className="settings-field"><span>Plants registered</span><b>{plantsCount}</b></div><div className="local-note settings-note"><Icon name="cloud" /><span><b>Local prototype</b><br />Data is stored in this app's local browser storage. It is not yet backed up to the server or synced across devices.</span></div><div className="danger-zone"><div><b>Reset local workspace</b><small>Removes this workspace and its plant list from this device only.</small></div><button className="danger-button" onClick={resetWorkspace}>Reset workspace</button></div></section></div>}
        <footer className="main-footer"><span>Solar Audit Mobile</span><span>Fresh workspace Â· Local prototype Â· Server sync not connected</span></footer>
      </main>
      <nav className="mobile-nav" aria-label="Mobile navigation">{navItems.slice(0, 5).map((item) => <button key={item.label} className={section === item.label ? "mobile-nav-item active" : "mobile-nav-item"} onClick={() => setSection(item.label)}><Icon name={item.icon} /><span>{item.label === "Sites & Plants" ? "Plants" : item.label}</span></button>)}</nav>
    </div>
  );
}


