      const pageHeight = pdf.internal.pageSize.getHeight();
      const margin = 14;
      const contentWidth = pageWidth - margin * 2;
      let y = 17;
      const ensureSpace = (height: number) => { if (y + height > pageHeight - 14) { pdf.addPage(); y = 16; } };
      const line = (text: string, size = 9, bold = false, indent = 0) => {
        pdf.setFont("helvetica", bold ? "bold" : "normal"); pdf.setFontSize(size);
        const lines = pdf.splitTextToSize(text || "â€”", contentWidth - indent);
        ensureSpace(lines.length * (size * 0.42) + 2);
        pdf.text(lines, margin + indent, y); y += lines.length * (size * 0.42) + 2;
      };
      const heading = (text: string) => { ensureSpace(12); y += 3; pdf.setFont("helvetica", "bold"); pdf.setFontSize(12); pdf.text(text, margin, y); y += 6; pdf.setDrawColor(150, 165, 154); pdf.line(margin, y, pageWidth - margin, y); y += 4; };
      const addPhoto = (photo: string, caption: string) => {
        if (!photo || !photo.startsWith("data:image/")) return;
        ensureSpace(66);
        try {
          const format = photo.startsWith("data:image/png") ? "PNG" : "JPEG";
          pdf.addImage(photo, format, margin + 2, y, 48, 48, undefined, "FAST");
          pdf.setFont("helvetica", "normal"); pdf.setFontSize(8);
          const captionLines = pdf.splitTextToSize(caption, contentWidth - 55);
          pdf.text(captionLines, margin + 54, y + 5);
          y += 53;
        } catch (error) { console.warn("Skipping a photo that could not be embedded in the PDF", error); }
      };

      pdf.setFont("helvetica", "bold"); pdf.setFontSize(19); pdf.text("SOLAR AUDIT REPORT", margin, y); y += 9;
      pdf.setFontSize(13); pdf.text(audit.title || "Untitled audit", margin, y); y += 7;
      pdf.setFont("helvetica", "normal"); pdf.setFontSize(9);
      line(`Organization: ${current.organizationName}`);
      line(`Site: ${current.siteName}${current.siteLocation ? ` â€” ${current.siteLocation}` : ""}`);
      line(`Plant: ${audit.plantName || current.plants.find((p) => p.id === audit.plantId)?.name || "Not specified"}`);
      line(`Audit type: ${audit.auditType}    Status: ${audit.status.replace("_", " ").toUpperCase()}`);
      line(`Audit date: ${audit.auditDate || "Not specified"}    Auditor: ${audit.auditor || "Not specified"}`);
      line(`Generated: ${new Date().toLocaleString()}`);

      heading("EXECUTIVE SUMMARY");
      const checkpoints = execution.flatMap((equipment) => equipment.checkpoints.map((checkpoint) => ({ equipment, checkpoint })));
      const count = (result: string) => checkpoints.filter((item) => item.checkpoint.result === result).length;
      line(`Equipment groups: ${execution.length}    Checkpoints: ${checkpoints.length}`);
      line(`Compliant: ${count("C")}    Non-compliant: ${count("NC")}    Not applicable: ${count("NA")}    Opportunities for improvement: ${count("OFI")}`);
      line(`Observations: ${auditObservations.length}    Open: ${auditObservations.filter((o) => o.status === "open").length}    Closed: ${auditObservations.filter((o) => o.status === "closed").length}`);

      heading("CHECKLIST & INSPECTION EVIDENCE");
      if (!execution.length) line("No equipment or checklist data has been saved for this audit.");
      for (const equipment of execution) {
        ensureSpace(10); pdf.setFont("helvetica", "bold"); pdf.setFontSize(10); pdf.text(`${equipment.name} â€” ${equipment.equipmentType}`, margin, y); y += 6;
        if (!equipment.checkpoints.length) line("No checkpoints saved.", 8, false, 3);
        for (const checkpoint of equipment.checkpoints) {
          line(`[${checkpoint.result}] ${checkpoint.checkpointText}`, 9, true, 3);
          if (checkpoint.remarks.trim()) line(`Remarks: ${checkpoint.remarks}`, 8, false, 6);
          for (let i = 0; i < (checkpoint.photos ?? []).length; i++) addPhoto(checkpoint.photos[i], `${equipment.name} Â· ${checkpoint.checkpointText} Â· Inspection photo ${i + 1}`);
          y += 1;
        }
      }

      heading("OBSERVATIONS & CORRECTIVE-ACTION EVIDENCE");
      if (!auditObservations.length) line("No NC or OFI observations are recorded for this audit.");
      for (const observation of auditObservations) {
        ensureSpace(22);
        line(`${observation.findingType} â€” ${observation.title}`, 10, true);
        line(`Checkpoint: ${observation.checkpointText}`);
        line(`Status: ${observation.status.toUpperCase()}    Severity: ${observation.severity}    Target date: ${observation.targetDate || "Not set"}`);
        line(`Responsible: ${observation.responsiblePerson || "Not assigned"}`);
        if (observation.description) line(`Description: ${observation.description}`);
        if (observation.actionText) line(`Action taken: ${observation.actionText}`);
        for (let i = 0; i < (observation.photos ?? []).length; i++) addPhoto(observation.photos[i], `${observation.title} Â· Inspection photo ${i + 1}`);
