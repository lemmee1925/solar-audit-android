  function addEquipmentToExistingPlant(plantId: string) {
    if (!workspace || !existingEquipmentCategory) {
      setMessage("Choose an equipment category first.");
      return;
    }
    const quantity = Number.parseInt(existingEquipmentQuantity, 10);
    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 500) {
      setMessage("Equipment quantity must be between 1 and 500.");
      return;
    }
    const updatedPlants = workspace.plants.map((plant) => {
      if (plant.id !== plantId) return plant;
      const equipment = [...(plant.equipment ?? [])];
      const existingNames = new Set(equipment.filter((item) => item.category === existingEquipmentCategory).map((item) => item.name));
      let nextIndex = 1;
      for (let added = 0; added < quantity; added += 1) {
        while (existingNames.has(`${existingEquipmentCategory} ${nextIndex}`)) nextIndex += 1;
        const name = `${existingEquipmentCategory} ${nextIndex}`;
        equipment.push({ id: `${plantId}-eq-${Math.random().toString(16).slice(2)}`, category: existingEquipmentCategory, name });
        existingNames.add(name);
        nextIndex += 1;
      }
      return { ...plant, equipment };
    });
    setWorkspace({ ...workspace, plants: updatedPlants });
    setExistingEquipmentCategory("");
    setExistingEquipmentQuantity("1");
    setMessage("Equipment inventory updated for this plant.");
  }

