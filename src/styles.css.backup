:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #1c211d;
  background: #f5f6f3;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --green: #1f6548;
  --green-dark: #174c37;
  --green-soft: #e7f1e9;
  --surface: #fff;
  --line: #e3e7e1;
  --muted: #6c756e;
  --amber: #a97c25;
}
* { box-sizing: border-box; }
html, body, #root { min-height: 100%; margin: 0; }
body { min-width: 320px; }
button { font: inherit; cursor: pointer; }
button:focus-visible { outline: 3px solid #88bca0; outline-offset: 2px; }
.app-shell { min-height: 100vh; padding-bottom: calc(76px + env(safe-area-inset-bottom)); }
.topbar { position: sticky; top: 0; z-index: 5; min-height: 68px; display: flex; align-items: center; gap: 11px; padding: 12px 18px; background: rgba(255,255,255,.96); border-bottom: 1px solid var(--line); backdrop-filter: blur(12px); }
.brand-mark { width: 38px; height: 38px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 12px; background: var(--green); color: #fff; font-weight: 850; font-size: 20px; }
.brand-copy { min-width: 0; }
.brand-title { font-size: 15px; font-weight: 780; letter-spacing: -.02em; }
.brand-subtitle { margin-top: 3px; font-size: 10px; color: var(--muted); }
.topbar-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
.runtime-pill { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); border-radius: 999px; padding: 6px 9px; background: #fbfcfa; color: #59625b; font-size: 10px; white-space: nowrap; }
.status-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #a9b0aa; flex: 0 0 auto; }
.status-dot--green { background: #3a8b5e; }
.status-dot--amber { background: #b58b36; }
.icon-button, .avatar-button { display: grid; place-items: center; border: 1px solid var(--line); background: #fff; color: #4d5b51; }
.icon-button { width: 36px; height: 36px; border-radius: 11px; font-size: 17px; }
.avatar-button { width: 38px; height: 38px; border-radius: 50%; background: var(--green-soft); color: var(--green-dark); font-weight: 800; }
.page-content { width: min(100% - 30px, 820px); margin: 0 auto; padding: 27px 0 24px; }
.page-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
.eyebrow { margin: 0 0 7px; color: var(--green); font-size: 9px; font-weight: 850; letter-spacing: .15em; }
h1 { margin: 0; font-size: clamp(27px, 6vw, 34px); line-height: 1.1; letter-spacing: -.045em; font-weight: 760; }
.page-subtitle { margin: 8px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
.connection-banner { display: flex; align-items: flex-start; gap: 11px; padding: 14px; border: 1px solid #eadfc6; border-radius: 15px; background: #fffaf0; }
.connection-icon { width: 29px; height: 29px; display: grid; place-items: center; border-radius: 10px; background: #f5ead1; flex: 0 0 auto; }
.connection-copy { display: grid; gap: 4px; min-width: 0; }
.connection-copy strong { font-size: 12px; }
.connection-copy span { color: #776d59; font-size: 10px; line-height: 1.5; }
.banner-tag { margin-left: auto; padding: 5px 7px; border-radius: 7px; background: #f4e9d0; color: #7b5a1a; font-size: 9px; white-space: nowrap; }
.section-block { margin-top: 25px; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 13px; }
.section-heading h2 { margin: 0; font-size: 15px; letter-spacing: -.02em; }
.section-heading p { margin: 5px 0 0; color: var(--muted); font-size: 10px; line-height: 1.4; }
.section-note { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 9px; white-space: nowrap; }
.metrics-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.metric-card { min-height: 108px; display: flex; flex-direction: column; align-items: flex-start; padding: 14px; border: 1px solid var(--line); border-radius: 15px; background: var(--surface); }
.metric-label { color: #5f6b62; font-size: 10px; font-weight: 650; }
.metric-value { margin-top: 9px; font-size: 26px; line-height: 1; letter-spacing: -.04em; color: #9ba39c; font-weight: 650; }
.metric-description { margin-top: 8px; color: #8a938b; font-size: 9px; }
.workflow-grid { display: grid; gap: 9px; }
.workflow-card { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 68px; padding: 12px; text-align: left; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); color: inherit; }
.workflow-card:active, .settings-row:active { background: #f6faf6; }
.workflow-icon { display: grid; place-items: center; width: 39px; height: 39px; border-radius: 12px; font-size: 15px; font-weight: 850; flex: 0 0 auto; }
.workflow-icon.technical { background: #e5edf9; color: #315c93; }
.workflow-icon.safety { background: #f8ebd9; color: #8c5d1d; }
.workflow-icon.civil { background: #e6f1e5; color: #3d7546; }
.workflow-text { display: grid; gap: 4px; min-width: 0; }
.workflow-text strong { font-size: 12px; }
.workflow-text small { color: var(--muted); font-size: 10px; line-height: 1.35; }
.arrow { margin-left: auto; color: #8b958d; font-size: 23px; }
.text-button { border: 0; background: transparent; color: var(--green); font-size: 10px; font-weight: 750; white-space: nowrap; }
.empty-state { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 7px; padding: 25px 18px; border: 1px dashed #d8ded7; border-radius: 15px; background: rgba(255,255,255,.65); }
.empty-state.large { margin-top: 4px; padding: 42px 22px; }
.empty-state-icon { display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: 3px; border-radius: 14px; background: #edf3ed; color: var(--green); font-size: 21px; }
.empty-state strong { font-size: 12px; }
.empty-state p { max-width: 340px; margin: 0; color: var(--muted); font-size: 10px; line-height: 1.6; }
.primary-button { margin-top: 12px; border: 0; border-radius: 10px; padding: 10px 15px; background: var(--green); color: #fff; font-size: 11px; font-weight: 750; }
.settings-list { overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: #fff; }
.settings-row { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 15px; border: 0; border-bottom: 1px solid var(--line); background: #fff; text-align: left; color: inherit; }
.settings-row > span:first-child { display: grid; gap: 4px; }
.settings-row strong { font-size: 12px; }
.settings-row small { color: var(--muted); font-size: 10px; }
.settings-row > span:last-child { color: #8a938b; font-size: 22px; }
.settings-footnote { padding: 13px 15px; color: var(--muted); font-size: 10px; line-height: 1.5; }
.page-footer { display: flex; justify-content: space-between; gap: 10px; margin: 24px 2px 0; color: #8a938b; font-size: 9px; }
.page-footer span:last-child { display: inline-flex; align-items: center; gap: 6px; text-align: right; }
.bottom-nav { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: repeat(5, 1fr); padding: 8px 8px calc(8px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: rgba(255,255,255,.97); backdrop-filter: blur(14px); }
.nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; min-width: 0; min-height: 48px; padding: 4px 2px; border: 0; border-radius: 10px; background: transparent; color: #7a847c; font-size: 9px; }
.nav-icon { font-size: 19px; line-height: 1; }
.nav-item.is-active { color: var(--green); background: #eef5ef; font-weight: 800; }
.menu-panel { position: fixed; z-index: 20; top: 72px; right: 12px; width: min(250px, calc(100vw - 24px)); padding: 10px; border: 1px solid var(--line); border-radius: 15px; background: #fff; box-shadow: 0 16px 40px rgba(20,40,25,.15); }
.menu-title { margin: 5px 8px 8px; color: var(--muted); font-size: 9px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
.menu-item { display: flex; justify-content: space-between; width: 100%; padding: 12px 10px; border: 0; border-radius: 9px; background: #fff; color: #29352d; text-align: left; font-size: 12px; }
.menu-item.is-active { background: var(--green-soft); color: var(--green-dark); font-weight: 750; }
.menu-item span { color: #8a938b; }
@media (min-width: 680px) {
  .page-content { padding-top: 34px; }
  .metrics-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .workflow-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .workflow-card { align-items: flex-start; min-height: 118px; flex-wrap: wrap; }
  .workflow-text { flex: 1 1 calc(100% - 52px); }
  .workflow-card .arrow { margin-left: auto; }
}
@media (max-width: 390px) {
  .topbar { padding-inline: 12px; }
  .runtime-pill { font-size: 9px; padding: 6px 7px; }
  .page-content { width: calc(100% - 24px); }
  .banner-tag { display: none; }
  .page-footer { flex-direction: column; }
}
